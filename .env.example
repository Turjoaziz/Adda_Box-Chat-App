# Copy this file to .env in the project root. Never commit your real .env.
# Use a running local MongoDB instance, or replace with your Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/adda_box

# Replace before starting. Generate a value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-generated-random-secret

PORT=4000
# Match the origin you use in the browser. Use one origin for the current Socket.IO setup.
CORS_ORIGIN=http://localhost:4000
