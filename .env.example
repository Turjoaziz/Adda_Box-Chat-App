# Copy this file to .env in the project root. Never commit your real .env.
# Use a running local MongoDB instance, or replace with your Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/adda_box

# Replace before starting. Generate a value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-generated-random-secret

PORT=4000
# Match the origin you use in the browser. Use one origin for the current Socket.IO setup.
CORS_ORIGIN=http://localhost:4000

# Public Adda Box URL used inside password-reset emails.
PASSWORD_RESET_BASE_URL=http://localhost:4000

# Preferred free password-reset delivery: Gmail SMTP.
# Enable 2-Step Verification on the Google account, create a Google App Password,
# and store that 16-character app password here (not the normal Gmail password).
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password

# Optional display sender. If omitted, Adda Box <SMTP_USER> is used.
# SMTP_FROM=Adda Box <your-gmail-address@gmail.com>

# Optional fallback provider: Resend.
# Leave these blank if Gmail SMTP is configured.
RESEND_API_KEY=
RESET_EMAIL_FROM=
